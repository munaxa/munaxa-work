{
  "name": "@work/employment",
  "version": "0.1.0",
  "private": true,
  "description": "Employment — the relationship between a person and the tenant's workforce: employment identity and lifecycle, organizational assignment on a timeline, the managerial relationship, contracts and probation, and the history that makes all of it answerable as at a date. Owns no identity, no structure, no attendance, no leave and no payroll.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./locales/en.json": "./locales/en.json",
    "./locales/ar.json": "./locales/ar.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ],
      "contracts": [
        "./dist/contracts/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@work/kernel": "workspace:*",
    "@work/organization": "workspace:*",
    "@work/persistence": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@work/testing": "workspace:*",
    "eslint": "^9.17.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
