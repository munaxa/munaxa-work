{
  "name": "@work/recruitment",
  "version": "0.1.0",
  "private": true,
  "description": "Recruitment \u2014 the hiring process, and the candidates who are not yet people: requisitions and their approval, vacancies, candidates, applications and their pipeline, interviews and feedback, offers, and the transition that turns an accepted offer into a Person and an Employment. Owns no identity, no structure and no employment.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./locales/en.json": "./locales/en.json",
    "./locales/ar.json": "./locales/ar.json"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@work/kernel": "workspace:*",
    "@work/persistence": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@work/testing": "workspace:*",
    "eslint": "^9.17.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
