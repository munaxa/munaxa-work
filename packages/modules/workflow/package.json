{
  "name": "@work/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise workflow and approvals \u2014 definitions, versions, instances, steps, approval requests and decisions. Orchestrates; owns no business data.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en.json": "./locales/en.json",
    "./locales/ar.json": "./locales/ar.json"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@work/testing": "workspace:*",
    "eslint": "^9.17.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@work/kernel": "workspace:*",
    "@work/persistence": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  }
}
