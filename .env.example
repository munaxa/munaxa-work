# Copy to .env for local development. Every variable is validated at startup by
# packages/config; a missing or invalid value fails the process rather than surfacing later.

NODE_ENV=development
APP_NAME=munaxa-work
APP_VERSION=0.1.0
BUILD_SHA=local

HOST=0.0.0.0
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://work:work@localhost:5432/work
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug
LOG_PRETTY=true

DEFAULT_LOCALE=en
DEFAULT_CALENDAR=gregorian
DEFAULT_TIME_ZONE=UTC

# The key People derives duplicate-match digests with. A national identifier is compared through
# a keyed digest rather than in plaintext, so the query that finds who else holds a number never
# reads one. Startup refuses this development value when NODE_ENV=production.
PII_MATCH_SECRET=development-only-people-match-secret-change-me

OPENAPI_ENABLED=true

# The external Munaxa issuer this deployment is a relying party of. Work verifies tokens and
# mints none, so no signing key belongs here or anywhere else in this repository — only the
# issuer's *public* verification keys, which are not secrets.
#
# Configure all three or none. Unset, the deployment authenticates nobody and every business
# request answers 401, which is the safe default and is refused outright when NODE_ENV=production.
# Values come from Operations; none is committed.
#
# AUTH_ISSUER=<the issuer identifier the token's `iss` must equal>
# AUTH_AUDIENCE=<the audience the issuer stamps for Munaxa Work>
# AUTH_PUBLIC_KEYS=[{"kid":"<key id>","publicKey":"-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----\n"}]
AUTH_SIGNING_ALGORITHM=RS256
AUTH_CLOCK_SKEW_MS=30000
