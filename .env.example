# Copy to .env for local development. Every variable is validated at startup by
# packages/config; a missing or invalid value fails the process rather than surfacing later.

NODE_ENV=development
APP_NAME=munaxa-work
APP_VERSION=0.1.0
BUILD_SHA=local

HOST=0.0.0.0
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://work:work@localhost:5432/work
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug
LOG_PRETTY=true

DEFAULT_LOCALE=en
DEFAULT_CALENDAR=gregorian
DEFAULT_TIME_ZONE=UTC

# The key People derives duplicate-match digests with. A national identifier is compared through
# a keyed digest rather than in plaintext, so the query that finds who else holds a number never
# reads one. Startup refuses this development value when NODE_ENV=production.
PII_MATCH_SECRET=development-only-people-match-secret-change-me

OPENAPI_ENABLED=true

# Platform authentication (ADR-0001). Munaxa Work verifies tokens Platform issued; it never
# issues one. Supply all four or none: none runs with UnauthenticatedPort and answers 401 to
# every business route, and a partial set fails startup rather than looking like a Platform
# outage. Only RS256 and ES256 are accepted — a symmetric algorithm would hand this deployment
# the key that mints the tokens it checks. PLATFORM_AUTH_PUBLIC_KEYS is a JSON array of
# {"kid","publicKey"}; private key material is refused. The values are Platform's to supply.
# PLATFORM_AUTH_ISSUER=
# PLATFORM_AUTH_AUDIENCE=
# PLATFORM_AUTH_ALGORITHM=
# PLATFORM_AUTH_PUBLIC_KEYS=
# PLATFORM_AUTH_CLOCK_SKEW_MS=30000
