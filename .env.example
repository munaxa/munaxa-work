# Copy to .env for local development. Every variable is validated at startup by
# packages/config; a missing or invalid value fails the process rather than surfacing later.

NODE_ENV=development
APP_NAME=munaxa-work
APP_VERSION=0.1.0
BUILD_SHA=local

HOST=0.0.0.0
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://work:work@localhost:5432/work
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug
LOG_PRETTY=true

DEFAULT_LOCALE=en
DEFAULT_CALENDAR=gregorian
DEFAULT_TIME_ZONE=UTC
# western | arabic-indic
DEFAULT_NUMERALS=western

# Workforce Identity fallbacks for a tenant that has stored no settings of its own (ADR-0036).
INVITATION_VALIDITY_DAYS=14
# Comma-separated: employee, manager, admin.
DEFAULT_PORTALS=employee

# The key People derives duplicate-match digests with. A national identifier is compared through
# a keyed digest rather than in plaintext, so the query that finds who else holds a number never
# reads one. Startup refuses this development value when NODE_ENV=production.
PII_MATCH_SECRET=development-only-people-match-secret-change-me

OPENAPI_ENABLED=true

# Platform authentication (ADR-0001). Munaxa Work verifies tokens Platform issued; it never
# issues one. Supply all four or none: none runs with UnauthenticatedPort and answers 401 to
# every business route, and a partial set fails startup rather than looking like a Platform
# outage. Only RS256 and ES256 are accepted — a symmetric algorithm would hand this deployment
# the key that mints the tokens it checks. PLATFORM_AUTH_PUBLIC_KEYS is a JSON array of
# {"kid","publicKey"}; private key material is refused. The values are Platform's to supply.
# PLATFORM_AUTH_ISSUER=
# PLATFORM_AUTH_AUDIENCE=
# PLATFORM_AUTH_ALGORITHM=
# PLATFORM_AUTH_PUBLIC_KEYS=
# PLATFORM_AUTH_CLOCK_SKEW_MS=30000
# Every verified token's session is also checked with Identity (ADR-0080). The URL defaults to
# ${PLATFORM_AUTH_ISSUER}/api/auth/introspect. "disabled" is for a machine with no Identity running
# and is refused in production. The cache is the revocation window (0-30000 ms).
# PLATFORM_AUTH_REVOCATION_CHECK=introspect
# PLATFORM_AUTH_INTROSPECTION_URL=
# PLATFORM_AUTH_REVOCATION_CACHE_MS=5000
# PLATFORM_AUTH_INTROSPECTION_TIMEOUT_MS=2000

# Licensing (ADR-0078, ADR-0079). NONE (default): nothing licensed, nothing gated; development and
# test only, refused when NODE_ENV=production even if unset. LICENSE_FILE: a
# signed Munaxa licence verified offline, for an installation on the customer's own server.
# CONTROL_PLANE: the central Munaxa subscription service, asked per tenant (Munaxa-hosted). A missing
# or invalid licence, or a tenant with no subscription, grants nothing; it never falls back to NONE.
# LICENSING_MODE=NONE
# LICENSE_FILE_PATH=/etc/munaxa/work.license
# LICENSE_PUBLIC_KEYS=
# LICENSE_ALGORITHM=ES256
# LICENSE_INSTALLATION_ID=
# The signed revocation list Munaxa delivers next to the licence (optional).
# LICENSE_REVOCATION_PATH=
# CONTROL_PLANE_URL=https://control.munaxa.com
# The deployment's service credential, issued in the Super Admin portal. A secret: inject it from
# the secret store, never commit it.
# CONTROL_PLANE_TOKEN=

# The migrate image only (apps/api/Dockerfile, target migrate): the owner role's connection string,
# which `prisma migrate deploy` and deploy/aws/runtime-grants.sql run as. Never given to the API.
# DATABASE_MIGRATION_URL=

# The admin portal (packages/config/src/portal-environment.ts). It needs no DATABASE_URL.
# WORK_API_URL=http://127.0.0.1:3000
# Platform's sign-in page; unset, the portal says sign-in is not configured.
# PLATFORM_SIGN_IN_URL=

# Integration tests only: the database the suites run against (migrated first).
# TEST_DATABASE_URL=postgresql://work:work@localhost:5432/work
