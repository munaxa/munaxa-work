{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Non-incremental deliberately. `nest build` deletes dist, and a surviving .tsbuildinfo then
    // convinces tsc that files it never re-emitted are current — producing a dist that is
    // missing modules and an application that fails at require time. A full emit every time
    // costs a second and removes the entire class of problem.
    "composite": false,
    "incremental": false
  },
  // Harnesses and fixtures are excluded alongside the tests they exist for. They were being
  // compiled into dist and shipped, which is how the API image came to require `@work/testing` at
  // runtime: a fake port implementation reached the running service's dependency graph. Test code
  // is reachable from tests and from nowhere else.
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.fixture.ts",
    "**/*harness*.ts",
    "**/*scenario*.ts",
    "**/*cross-module*.ts",
    "**/phase-*-configuration.ts"
  ]
}
