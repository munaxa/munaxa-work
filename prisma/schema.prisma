// Munaxa Work — the product's own schema, shared with no one.
//
// Every model here obeys the rules that outlive every phase, enforced by
// scripts/check-architecture.mjs: tenant_id, the audit columns, soft delete, version, a UUIDv7
// identifier and snake_case mapping. A model that is genuinely global says so with a
// `/// @global <reason>` comment, and there is exactly one — see ADR-0033.
//
// Row-level security is applied by the migration that creates each table, never afterwards
// (ADR-0030). See docs/MASTER_INSTRUCTIONS.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// @global one-row-per-Platform-account: a person who works for two tenants is one person (ADR-0033)
model WorkforceUser {
  id               String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  platform_user_id String    @unique @db.VarChar(255)
  status           String    @db.VarChar(32)
  created_at       DateTime  @db.Timestamptz(6)
  created_by       String    @db.VarChar(255)
  updated_at       DateTime  @db.Timestamptz(6)
  updated_by       String    @db.VarChar(255)
  deleted_at       DateTime? @db.Timestamptz(6)
  deleted_by       String?   @db.VarChar(255)
  version          Int

  @@index([status], map: "workforce_user_status_idx")
  @@map("workforce_user")
}

model TenantMembership {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id         String    @db.Uuid
  workforce_user_id String    @db.Uuid
  status            String    @db.VarChar(32)
  invited_at        DateTime? @db.Timestamptz(6)
  joined_at         DateTime? @db.Timestamptz(6)
  ended_at          DateTime? @db.Timestamptz(6)
  created_at        DateTime  @db.Timestamptz(6)
  created_by        String    @db.VarChar(255)
  updated_at        DateTime  @db.Timestamptz(6)
  updated_by        String    @db.VarChar(255)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_by        String?   @db.VarChar(255)
  version           Int

  @@unique([tenant_id, workforce_user_id], map: "tenant_membership_tenant_user_key")
  @@index([workforce_user_id, status], map: "tenant_membership_user_status_idx")
  @@index([tenant_id, status], map: "tenant_membership_tenant_status_idx")
  @@map("tenant_membership")
}

model Invitation {
  id                            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                     String    @db.Uuid
  email                         String    @db.VarChar(320)
  portals                       String[]
  status                        String    @db.VarChar(32)
  issued_at                     DateTime  @db.Timestamptz(6)
  expires_at                    DateTime  @db.Timestamptz(6)
  accepted_at                   DateTime? @db.Timestamptz(6)
  accepted_by_workforce_user_id String?   @db.Uuid
  created_at                    DateTime  @db.Timestamptz(6)
  created_by                    String    @db.VarChar(255)
  updated_at                    DateTime  @db.Timestamptz(6)
  updated_by                    String    @db.VarChar(255)
  deleted_at                    DateTime? @db.Timestamptz(6)
  deleted_by                    String?   @db.VarChar(255)
  version                       Int

  @@index([tenant_id, status], map: "invitation_tenant_status_idx")
  @@index([tenant_id, email], map: "invitation_tenant_email_idx")
  @@index([status, expires_at], map: "invitation_expiry_sweep_idx")
  @@map("invitation")
}

model PortalAssignment {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id     String    @db.Uuid
  membership_id String    @db.Uuid
  portal        String    @db.VarChar(32)
  status        String    @db.VarChar(32)
  granted_at    DateTime  @db.Timestamptz(6)
  revoked_at    DateTime? @db.Timestamptz(6)
  created_at    DateTime  @db.Timestamptz(6)
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String    @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)
  version       Int

  @@unique([tenant_id, membership_id, portal], map: "portal_assignment_membership_portal_key")
  @@index([tenant_id, membership_id, status], map: "portal_assignment_membership_status_idx")
  @@map("portal_assignment")
}

model EmploymentLink {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id     String    @db.Uuid
  membership_id String    @db.Uuid
  /// Employment's identifier (Phase 5). Referenced by identity only — deliberately no foreign
  /// key, because a foreign key here would couple this module's schema to another module's.
  employment_id String    @db.Uuid
  is_primary    Boolean
  status        String    @db.VarChar(32)
  linked_at     DateTime  @db.Timestamptz(6)
  unlinked_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @db.Timestamptz(6)
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String    @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)
  version       Int

  @@unique([tenant_id, membership_id, employment_id], map: "employment_link_membership_employment_key")
  @@index([tenant_id, employment_id], map: "employment_link_employment_idx")
  @@index([tenant_id, membership_id, status], map: "employment_link_membership_status_idx")
  @@map("employment_link")
}

model Delegation {
  id                       String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                String    @db.Uuid
  delegator_membership_id  String    @db.Uuid
  delegate_membership_id   String    @db.Uuid
  scope                    String    @db.VarChar(128)
  effective_from           DateTime  @db.Timestamptz(6)
  effective_to             DateTime  @db.Timestamptz(6)
  status                   String    @db.VarChar(32)
  reason                   String    @db.VarChar(512)
  created_at               DateTime  @db.Timestamptz(6)
  created_by               String    @db.VarChar(255)
  updated_at               DateTime  @db.Timestamptz(6)
  updated_by               String    @db.VarChar(255)
  deleted_at               DateTime? @db.Timestamptz(6)
  deleted_by               String?   @db.VarChar(255)
  version                  Int

  @@index([tenant_id, delegate_membership_id, status], map: "delegation_delegate_status_idx")
  @@index([tenant_id, delegator_membership_id, status], map: "delegation_delegator_status_idx")
  @@index([status, effective_to], map: "delegation_expiry_sweep_idx")
  @@map("delegation")
}

model BusinessProfile {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  membership_id  String    @db.Uuid
  /// Language tag to text. Both first-class languages are present before a row is written.
  display_name   Json
  job_title      Json?
  business_email String?   @db.VarChar(320)
  business_phone String?   @db.VarChar(64)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@unique([tenant_id, membership_id], map: "business_profile_membership_key")
  @@map("business_profile")
}

model UserPreference {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id     String    @db.Uuid
  membership_id String    @db.Uuid
  language      String    @db.VarChar(35)
  calendar      String    @db.VarChar(16)
  time_zone     String    @db.VarChar(64)
  numerals      String    @db.VarChar(16)
  created_at    DateTime  @db.Timestamptz(6)
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String    @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)
  version       Int

  @@unique([tenant_id, membership_id], map: "user_preference_membership_key")
  @@map("user_preference")
}

// ------------------------------------------------------------------------------------------
// Organization (Phase 3).
//
// There is no `Company`, `Branch` or `Team` model here, and no model per level at all. Nine
// models would be nine levels, and AD-003 requires unlimited depth — so the levels are rows in
// `OrganizationUnitType` and every node is an `OrganizationUnit` (ADR-0034).
// ------------------------------------------------------------------------------------------

model OrganizationUnitType {
  id                   String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id            String    @db.Uuid
  code                 String    @db.VarChar(64)
  /// Language tag to text. Both first-class languages are present before a row is written.
  name                 Json
  /// Display order in an administration screen. Deliberately not a depth (AD-003).
  ordinal              Int
  allowed_parent_codes String[]
  allowed_at_root      Boolean
  carries_legal_entity Boolean
  status               String    @db.VarChar(32)
  created_at           DateTime  @db.Timestamptz(6)
  created_by           String    @db.VarChar(255)
  updated_at           DateTime  @db.Timestamptz(6)
  updated_by           String    @db.VarChar(255)
  deleted_at           DateTime? @db.Timestamptz(6)
  deleted_by           String?   @db.VarChar(255)
  version              Int

  @@index([tenant_id, ordinal], map: "organization_unit_type_tenant_ordinal_idx")
  @@map("organization_unit_type")
}

model OrganizationUnit {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  unit_type_id   String    @db.Uuid
  code           String    @db.VarChar(64)
  name           Json
  description    Json?
  status         String    @db.VarChar(32)
  /// Tenant-authored, stored and never interpreted. No rule in the module reads a key (AD-005).
  metadata       Json
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, unit_type_id], map: "organization_unit_tenant_type_idx")
  @@index([tenant_id, status], map: "organization_unit_tenant_status_idx")
  @@map("organization_unit")
}

/// Where each unit sat, and from when. Never edited — a move closes one period and opens
/// another, so "what did this structure look like on this date" keeps exactly one answer.
model OrganizationUnitPlacement {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  unit_id        String    @db.Uuid
  /// Null means the unit was a root of the tenant's structure for this period.
  parent_unit_id String?   @db.Uuid
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, unit_id, effective_from], map: "organization_unit_placement_unit_idx")
  @@index([tenant_id, effective_from, effective_to], map: "organization_unit_placement_in_force_idx")
  @@index([tenant_id, parent_unit_id], map: "organization_unit_placement_parent_idx")
  @@map("organization_unit_placement")
}

model LegalEntity {
  id                  String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id           String    @db.Uuid
  unit_id             String    @db.Uuid
  /// ISO 3166-1 alpha-2. An employment resolves its country pack from here and never from the
  /// tenant (00B, ADR-0035), which is what lets one tenant operate several countries at once.
  country_code        String    @db.Char(2)
  registered_name     Json
  registration_number String    @db.VarChar(64)
  tax_identifier      String?   @db.VarChar(64)
  /// ISO 4217. On the entity rather than the tenant, for the same reason the country is.
  currency_code       String    @db.Char(3)
  incorporated_on     DateTime? @db.Date
  status              String    @db.VarChar(32)
  metadata            Json
  effective_from      DateTime  @db.Timestamptz(6)
  effective_to        DateTime? @db.Timestamptz(6)
  created_at          DateTime  @db.Timestamptz(6)
  created_by          String    @db.VarChar(255)
  updated_at          DateTime  @db.Timestamptz(6)
  updated_by          String    @db.VarChar(255)
  deleted_at          DateTime? @db.Timestamptz(6)
  deleted_by          String?   @db.VarChar(255)
  version             Int

  @@index([tenant_id, country_code], map: "legal_entity_tenant_country_idx")
  @@map("legal_entity")
}

/// Cost and profit centres share a table and differ by `kind`. Two near-identical tables would
/// be duplicated logic that drifts the first time one of them gains a column (AD-007).
model FinancialCenter {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  kind           String    @db.VarChar(16)
  code           String    @db.VarChar(64)
  name           Json
  unit_id        String?   @db.Uuid
  status         String    @db.VarChar(32)
  metadata       Json
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, kind, status], map: "financial_center_tenant_kind_status_idx")
  @@index([tenant_id, unit_id], map: "financial_center_unit_idx")
  @@map("financial_center")
}

/// Named `job_position` because POSITION is a SQL function, and a table of that name needs
/// quoting in every statement that touches it. No occupant column: people occupy positions
/// through Employment assignments (AD-006).
model JobPosition {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  code           String    @db.VarChar(64)
  title          Json
  description    Json?
  family         String?   @db.VarChar(64)
  grade          String?   @db.VarChar(64)
  criticality    String    @db.VarChar(16)
  status         String    @db.VarChar(32)
  metadata       Json
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, status], map: "job_position_tenant_status_idx")
  @@index([tenant_id, family], map: "job_position_tenant_family_idx")
  @@map("job_position")
}

/// Budgeted headcount per position per unit, effective dated. Organization owns the budgeted
/// number and never the filled one — filled counts assignments, and Employment owns those
/// (AD-002).
model PositionEstablishment {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  position_id        String    @db.Uuid
  unit_id            String    @db.Uuid
  budgeted_headcount Int
  status             String    @db.VarChar(32)
  approved_at        DateTime? @db.Timestamptz(6)
  approved_by        String?   @db.VarChar(255)
  effective_from     DateTime  @db.Timestamptz(6)
  effective_to       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@index([tenant_id, unit_id], map: "position_establishment_unit_idx")
  @@index([tenant_id, position_id, effective_from], map: "position_establishment_position_idx")
  @@map("position_establishment")
}

model OrganizationCalendar {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  code           String    @db.VarChar(64)
  name           Json
  unit_id        String?   @db.Uuid
  time_zone      String    @db.VarChar(64)
  /// ISO-8601 weekdays ordinarily worked: Monday is 1, Sunday is 7. Tenant configuration; there
  /// is no default anywhere in the product (00B).
  working_days   Int[]     @db.SmallInt
  status         String    @db.VarChar(32)
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, unit_id], map: "organization_calendar_unit_idx")
  @@map("organization_calendar")
}

/// A holiday is a day in a place, not an instant, so `on_date` is a date and the calendar
/// carries the zone. Stored as a timestamp it lands a day out for anybody east or west of it.
model OrganizationCalendarDay {
  id          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id   String    @db.Uuid
  calendar_id String    @db.Uuid
  on_date     DateTime  @db.Date
  kind        String    @db.VarChar(16)
  name        Json
  created_at  DateTime  @db.Timestamptz(6)
  created_by  String    @db.VarChar(255)
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String    @db.VarChar(255)
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.VarChar(255)
  version     Int

  @@unique([tenant_id, calendar_id, on_date], map: "organization_calendar_day_date_key")
  @@index([tenant_id, calendar_id, on_date], map: "organization_calendar_day_range_idx")
  @@map("organization_calendar_day")
}

/// One tenant's own language, calendar, time zone, numerals and invitation validity. This table
/// closes the deployment-wide-settings debt the Phase 2 report recorded (ADR-0036).
model TenantSettings {
  id                       String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                String    @db.Uuid
  language                 String    @db.VarChar(35)
  calendar                 String    @db.VarChar(16)
  time_zone                String    @db.VarChar(64)
  numerals                 String    @db.VarChar(16)
  invitation_validity_days Int
  default_portals          String[]
  created_at               DateTime  @db.Timestamptz(6)
  created_by               String    @db.VarChar(255)
  updated_at               DateTime  @db.Timestamptz(6)
  updated_by               String    @db.VarChar(255)
  deleted_at               DateTime? @db.Timestamptz(6)
  deleted_by               String?   @db.VarChar(255)
  version                  Int

  @@map("tenant_settings")
}
