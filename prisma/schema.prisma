  @@index([tenant_id, status], map: "letter_request_status_idx")
  @@map("letter_request")
}

/// The issued letter, frozen at issue.
///
/// `substituted_values` is the snapshot: every value the template resolved, beside the template
/// version that produced them. A salary certificate issued in March still reads March's salary
/// after April's raise, because nothing re-reads a source after issue.
///
/// `document_id` is the rendered artefact and stays null: no renderer exists. The letter's content
/// is owned and reproducible without one.
model LetterIssued {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  letter_request_id          String    @db.Uuid
  letter_template_id         String    @db.Uuid
  letter_template_version_id String    @db.Uuid
  employment_id              String    @db.Uuid
  person_id                  String    @db.Uuid
  reference_number           String    @db.VarChar(64)
  /// Unguessable. A third party confirms authenticity with this and sees no employee data.
  verification_token         String    @db.VarChar(64)
  locale                     String    @db.VarChar(8)
  substituted_values         Json
  source_versions            Json
  issued_at                  DateTime  @db.Timestamptz(6)
  issued_by                  String    @db.VarChar(255)
  signatory                  String?   @db.VarChar(255)
  signature_required         Boolean
  /// No `signed` state exists: no signature provider does either.
  signature_state            String    @db.VarChar(24)
  document_id                String?   @db.Uuid
  superseded_by_id           String?   @db.Uuid
  superseded_at              DateTime? @db.Timestamptz(6)
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@unique([tenant_id, reference_number], map: "letter_issued_reference_idx")
  @@unique([verification_token], map: "letter_issued_token_idx")
  @@unique([tenant_id, letter_request_id], map: "letter_issued_request_idx")
  @@index([tenant_id, employment_id, issued_at(sort: Desc)], map: "letter_issued_employment_idx")
  @@map("letter_issued")
}

/// A named human's decision on a letter request. Self-approval is refused by a check constraint,
