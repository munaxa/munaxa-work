/// Free text an administrator wrote about somebody. Never amended and never deleted: a note that
/// could be edited after the fact cannot be relied on in a disciplinary case.
model PersonNote {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id     String    @db.Uuid
  person_id     String    @db.Uuid
  category_code String    @db.VarChar(64)
  body          String    @db.Text
  /// Taken from the authenticated context. A caller cannot supply it.
  authored_by   String    @db.VarChar(255)
  authored_at   DateTime  @db.Timestamptz(6)
  withdrawn_at  DateTime? @db.Timestamptz(6)
  created_at    DateTime  @db.Timestamptz(6)
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String    @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)
  version       Int

  @@index([tenant_id, person_id, authored_at], map: "person_note_person_idx")
  @@map("person_note")
}

/// Two records the system suspects are one human being, awaiting a decision. The pair is stored
/// ordered, so detecting A against B and later B against A queues one decision rather than two.
model PersonDuplicateCandidate {
  id                       String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                String    @db.Uuid
  person_id                String    @db.Uuid
  duplicate_of_person_id   String    @db.Uuid
  reason                   String    @db.VarChar(64)
  confidence               Int
  status                   String    @db.VarChar(16)
  reviewed_by              String?   @db.VarChar(255)
  reviewed_at              DateTime? @db.Timestamptz(6)
  review_note              String?   @db.VarChar(1024)
  created_at               DateTime  @db.Timestamptz(6)
  created_by               String    @db.VarChar(255)
  updated_at               DateTime  @db.Timestamptz(6)
  updated_by               String    @db.VarChar(255)
  deleted_at               DateTime? @db.Timestamptz(6)
  deleted_by               String?   @db.VarChar(255)
  version                  Int

  @@unique([tenant_id, person_id, duplicate_of_person_id], map: "person_duplicate_candidate_pair_key")
  @@index([tenant_id, status], map: "person_duplicate_candidate_status_idx")
  @@map("person_duplicate_candidate")
}
