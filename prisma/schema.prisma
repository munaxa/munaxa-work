// ---------------------------------------------------------------------------------------------
// Payroll — what is actually paid for a period (Phase 11).
//
// Fourteen tables. Every monetary value is `amount_minor BigInt` + `currency_code` +
// `currency_exponent`, the convention ADR-0061 set: never `Float`, never `Decimal`, never a
// JavaScript number. The exponent travels on every row because nothing in this product publishes
// one, and two decimal places is a habit rather than a rule.
//
// `payroll_input_snapshot` holds the four published contract views verbatim as `Json`. That is
// deliberate (ADR-0064): the snapshot's job is to preserve what a contract *said*, and a contract
// that gains a field later must not make an old snapshot unreadable or force a migration of
// historical payroll.
//
// Six tables carry `finalized_at`, and a database trigger refuses any update or delete of a row
// where it is set (ADR-0066). Prisma cannot express that; the migration does.
//
// Absent, and deliberately: no tax column, no social-security column, no exchange rate, no bank
// account, no ledger, and no `posted` or `executed` state anywhere (ADR-0067).
// ---------------------------------------------------------------------------------------------

model PayrollGroup {
  id                       String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                String    @db.Uuid
  legal_entity_id          String    @db.Uuid
  code                     String    @db.VarChar(64)
  name                     Json
  pay_frequency            String    @db.VarChar(24)
  permitted_currencies     Json
  proration_basis          String    @db.VarChar(24)
  rounding_mode            String    @db.VarChar(16)
  pays_suspended           Boolean
  eligibility_rule         Json?
  eligibility_rule_version Int
  country_pack_id          String?   @db.VarChar(64)
  country_pack_version     Int?
  expense_account          String    @db.VarChar(64)
  deduction_account        String    @db.VarChar(64)
  payable_account          String    @db.VarChar(64)
  payment_method_code      String    @db.VarChar(64)
  active                   Boolean
  metadata                 Json
  created_at               DateTime  @db.Timestamptz(6)
  created_by               String    @db.VarChar(255)
  updated_at               DateTime  @db.Timestamptz(6)
  updated_by               String    @db.VarChar(255)
  deleted_at               DateTime? @db.Timestamptz(6)
  deleted_by               String?   @db.VarChar(255)
  version                  Int

  @@unique([tenant_id, code], map: "payroll_group_code_idx")
  @@map("payroll_group")
}

