// ------------------------------------------------------------------------------------------------
// Performance management (Phase 13). Goals, competencies, review cycles, assessments, calibration
// and talent classification.
//
// No column here is a floating-point type. Weights are integer basis points, scores are integer
// hundredths, key-result values are integers carrying their own exponent — the discipline ADR-0061
// established for money, applied to a number that decides somebody's rating.
//
// The word `grade` does not appear: `position.grade` means a job's level and `compensation_pay_grade`
// means a pay band, so a performance level is a `PerformanceRatingLevel` (D-7).
// ------------------------------------------------------------------------------------------------

/// The scale a tenant rates against, and the range a calculated score must fall in.
///
/// Scores are hundredths, so a 1–5 scale stores 100 and 500. A calculation landing outside the range
/// fails explicitly rather than clamping: a silently clamped rating is a wrong rating that looks
/// right. Effective-dated, so changing the scale does not change what last year was rated against.
model PerformanceRatingScale {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  code           String    @db.VarChar(64)
  name           Json
  description    Json?
  /// Hundredths. The lower bound of a valid calculated score.
  minimum_score  Int
  /// Hundredths. The upper bound of a valid calculated score.
  maximum_score  Int
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  active         Boolean
  metadata       Json
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@unique([tenant_id, code], map: "performance_rating_scale_code_idx")
  @@map("performance_rating_scale")
}

/// One band on a scale — "Exceeds expectations" — and the hundredths range that earns it.
model PerformanceRatingLevel {
  id                          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                   String    @db.Uuid
  performance_rating_scale_id String    @db.Uuid
  code                        String    @db.VarChar(64)
  name                        Json
  description                 Json?
  /// Lowest to highest. What a nine-box placement and a calibration comparison order by.
  ordinal                     Int       @db.SmallInt
  minimum_score               Int
  maximum_score               Int
  created_at                  DateTime  @db.Timestamptz(6)
  created_by                  String    @db.VarChar(255)
  updated_at                  DateTime  @db.Timestamptz(6)
  updated_by                  String    @db.VarChar(255)
  deleted_at                  DateTime? @db.Timestamptz(6)
  deleted_by                  String?   @db.VarChar(255)
  version                     Int

  @@unique([tenant_id, performance_rating_scale_id, code], map: "performance_rating_level_code_idx")
  @@unique([tenant_id, performance_rating_scale_id, ordinal], map: "performance_rating_level_ordinal_idx")
  @@map("performance_rating_level")
}

/// A named, versioned set of competencies.
///
/// `weighted` is D-6's third decision: weights are used only where the framework explicitly carries
/// them, and none are invented for a framework that does not.
model PerformanceCompetencyFramework {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id         String    @db.Uuid
  code              String    @db.VarChar(64)
  /// Part of the identity. Redefining a competency publishes a new version.
  framework_version Int
  name              Json
  description       Json?
  weighted          Boolean
  effective_from    DateTime  @db.Date
  effective_to      DateTime? @db.Date
  active            Boolean
  metadata          Json
  created_at        DateTime  @db.Timestamptz(6)
  created_by        String    @db.VarChar(255)
  updated_at        DateTime  @db.Timestamptz(6)
  updated_by        String    @db.VarChar(255)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_by        String?   @db.VarChar(255)
  version           Int

  @@unique([tenant_id, code, framework_version], map: "performance_competency_framework_code_idx")
  @@map("performance_competency_framework")
}

/// One competency within a framework: what a manager observed of the job.
///
/// Not what a person claims (`person_capability`, Phase 4) and not what they have attained
/// (Learning, Phase 14). That boundary is the most consequential line in this phase (D-9).
model PerformanceCompetency {
  id                  String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id           String    @db.Uuid
  framework_id        String    @db.Uuid
  code                String    @db.VarChar(64)
  name                Json
  description         Json?
  category            String    @db.VarChar(32)
  /// Null unless the parent framework says it is weighted. No weight is invented.
  weight_basis_points Int?
  display_order       Int       @db.SmallInt
  active              Boolean
  created_at          DateTime  @db.Timestamptz(6)
  created_by          String    @db.VarChar(255)
  updated_at          DateTime  @db.Timestamptz(6)
  updated_by          String    @db.VarChar(255)
  deleted_at          DateTime? @db.Timestamptz(6)
  deleted_by          String?   @db.VarChar(255)
  version             Int

  @@unique([tenant_id, framework_id, code], map: "performance_competency_code_idx")
  @@map("performance_competency")
}

/// A behavioural level on a competency, and the hundredths score demonstrating it earns.
model PerformanceCompetencyLevel {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  competency_id          String    @db.Uuid
  ordinal                Int       @db.SmallInt
  name                   Json
  behavioural_indicators Json
  score                  Int
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@unique([tenant_id, competency_id, ordinal], map: "performance_competency_level_ordinal_idx")
  @@map("performance_competency_level")
}

/// What a tenant calls a kind of goal. Configuration, and nothing more.
model PerformanceGoalCategory {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id  String    @db.Uuid
  code       String    @db.VarChar(64)
