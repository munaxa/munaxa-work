// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Leave & Absence Management (Phase 9)
//
// Leave owns the authorization to be absent. Attendance owns what actually happened. Payroll owns
// what it costs. Fourteen tables, and three of them carry the module's whole reliability argument:
// `leave_ledger_entry` is append-only and authoritative, `leave_balance` is a projection derived
// from it, and `leave_request_day` is the coverage Attendance reads.
//
// No column here holds money. No table holds a person, an employee number or an employment status.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

/// A category of leave, entirely tenant-configured. Nothing is seeded — not annual, not sick, not
/// a code. `statutory_source_code` is null until a country pack authors one (00B, ADR-0025).
model LeaveType {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id             String    @db.Uuid
  code                  String    @db.VarChar(64)
  name                  Json
  /// The unit the type is *expressed* in. Storage is always minutes.
  unit                  String    @db.VarChar(16)
  /// A tenant or country-pack code. Leave stores it and never interprets it; Payroll does.
  paid_treatment_code   String    @db.VarChar(64)
  /// Whether the type has entitlement at all. Unpaid leave typically does not.
  accrues               Boolean
