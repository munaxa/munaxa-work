// ═══════════════════════════════════════════════════════════════════════════════════════════════
// COMPENSATION MANAGEMENT (Phase 10)
//
// What an employment is entitled to receive. Employment says somebody is employed; Compensation
// says what they are entitled to; Payroll says what is actually paid for a period. Fourteen
// tables, and three decisions carry the module's whole reliability argument: money is integer
// minor units with its currency and exponent beside it, `compensation_recurring` is authoritative
// and its value columns are never rewritten, and overlapping periods are refused by a GiST
// exclusion constraint rather than by application code.
//
// No column here holds a tax, a social-security treatment, a gross, a net, a deduction or an
// end-of-service figure. No table holds a person, an employment status or an attendance fact.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

/// A compensation plan version — the configuration an employment is assigned to. Immutable once
/// published: a compensation record names the version that governed it, so a plan edited in June
/// cannot rewrite what March meant. Nothing is seeded.
model CompensationPlan {
  id                            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                     String    @db.Uuid
  code                          String    @db.VarChar(64)
  name                          Json
  version_number                Int
  status                        String    @db.VarChar(24)
  /// Optional. Every level of the salary hierarchy is optional; a plan naming no structure is the
  /// ordinary shape for a company paying simple salaries.
  salary_structure_id           String?   @db.Uuid
  default_currency_code         String    @db.Char(3)
  /// Carried rather than looked up: nothing in this product publishes a currency's exponent, and
  /// two decimal places is a habit rather than a rule (D-2).
  default_currency_exponent     Int       @db.SmallInt
  approval_required             Boolean
  approvals_required            Int       @db.SmallInt
  self_approval_permitted       Boolean
  /// Change control in basis points. Nullable and inert when null; nothing statutory is implied.
  maximum_increase_basis_points Int?
  maximum_decrease_basis_points Int?
  /// Null for a tenant-defined plan; set when a country pack authored this version.
  country_pack_id               String?   @db.VarChar(64)
  country_pack_version          Int?
  published_at                  DateTime? @db.Timestamptz(6)
  published_by                  String?   @db.VarChar(255)
  metadata                      Json
  created_at                    DateTime  @db.Timestamptz(6)
  created_by                    String    @db.VarChar(255)
  updated_at                    DateTime  @db.Timestamptz(6)
  updated_by                    String    @db.VarChar(255)
  deleted_at                    DateTime? @db.Timestamptz(6)
  deleted_by                    String?   @db.VarChar(255)
  version                       Int

  @@index([tenant_id, status], map: "compensation_plan_status_idx")
  @@map("compensation_plan")
}

/// Which plan version governs which scope, effective-dated. Most-specific-wins is resolved in the
/// domain; a tie is refused rather than broken.
model CompensationPlanAssignment {
  id                   String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id            String    @db.Uuid
  compensation_plan_id String    @db.Uuid
  scope                String    @db.VarChar(24)
  scope_id             String?   @db.Uuid
  effective_from       DateTime  @db.Date
  effective_to         DateTime? @db.Date
  reason_code          String?   @db.VarChar(64)
  created_at           DateTime  @db.Timestamptz(6)
  created_by           String    @db.VarChar(255)
