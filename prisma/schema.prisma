  updated_by String    @db.VarChar(255)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.VarChar(255)
  version    Int

  @@unique([tenant_id, code], map: "performance_goal_category_code_idx")
  @@map("performance_goal_category")
}

/// The shape of a review: which scale, which framework, what is required, and what the goals must
/// weigh in total.
///
/// `minimum_peer_responses` withholds an aggregate computed from too few responses. It is a display
/// rule, not an anonymity guarantee, and nothing here claims otherwise (D-12).
model PerformanceReviewTemplate {
  id                             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                      String    @db.Uuid
  code                           String    @db.VarChar(64)
  name                           Json
  description                    Json?
  rating_scale_id                String    @db.Uuid
  competency_framework_id        String?   @db.Uuid
  requires_self_assessment       Boolean
  requires_peer_assessment       Boolean
  requires_calibration           Boolean
  /// D-5's "must total", made tenant-configurable rather than hard-coded at 10,000.
  goal_weight_total_basis_points Int
  minimum_peer_responses         Int?      @db.SmallInt
  active                         Boolean
  metadata                       Json
  created_at                     DateTime  @db.Timestamptz(6)
  created_by                     String    @db.VarChar(255)
  updated_at                     DateTime  @db.Timestamptz(6)
  updated_by                     String    @db.VarChar(255)
  deleted_at                     DateTime? @db.Timestamptz(6)
  deleted_by                     String?   @db.VarChar(255)
  version                        Int

  @@unique([tenant_id, code], map: "performance_review_template_code_idx")
  @@map("performance_review_template")
}

/// What the final score is made of, and how much each part counts.
///
/// Integer basis points, and the set must total 10,000 (D-6). That total is a cross-row invariant no
/// check constraint can express, so the domain enforces it when a template is defined, the scoring
/// engine refuses to score without it, and the reconciliation query reports any set that drifted.
model PerformanceReviewTemplateComponent {
  id                  String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id           String    @db.Uuid
  template_id         String    @db.Uuid
  component           String    @db.VarChar(24)
  weight_basis_points Int
  created_at          DateTime  @db.Timestamptz(6)
  created_by          String    @db.VarChar(255)
  updated_at          DateTime  @db.Timestamptz(6)
  updated_by          String    @db.VarChar(255)
  deleted_at          DateTime? @db.Timestamptz(6)
  deleted_by          String?   @db.VarChar(255)
  version             Int

  @@unique([tenant_id, template_id, component], map: "performance_review_template_component_idx")
  @@map("performance_review_template_component")
}

/// One goal, at whichever level of the organization set it.
///
/// A goal outlives the cycle that assessed it, which is why `cycle_id` is nullable and a goal is not
/// a child of a review. `title` and `description` are free text rather than bilingual `Json`: a goal
/// is written once by one person in the language they were speaking (§17).
model PerformanceGoal {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id             String    @db.Uuid
  goal_category_id      String?   @db.Uuid
  /// D-4's explicit parent reference — Organization's shape, at a shallower depth.
  parent_goal_id        String?   @db.Uuid
  cycle_id              String?   @db.Uuid
  scope                 String    @db.VarChar(16)
  /// Employment's row. No foreign key: a cross-module key does not enforce tenant isolation.
  employment_id         String?   @db.Uuid
  organization_unit_id  String?   @db.Uuid
  title                 String    @db.VarChar(255)
  description           String?
  measurement           String    @db.VarChar(24)
  target_description    String?
  weight_basis_points   Int
  status                String    @db.VarChar(16)
  start_date            DateTime  @db.Date
  due_date              DateTime  @db.Date
  progress_basis_points Int
  approved_at           DateTime? @db.Timestamptz(6)
  /// A named human. `system:auto-approval` is refused by a check constraint (D-15).
  approved_by           String?   @db.VarChar(255)
  closed_at             DateTime? @db.Timestamptz(6)
  closed_by             String?   @db.VarChar(255)
  /// Hundredths, at closure. Null while open, and null forever on a cancelled goal (D-6).
  final_score           Int?
  closure_reason        String?   @db.VarChar(1024)
  /// Documents' row identifier and nothing else. No bytes, no metadata copy (D-24).
  evidence_document_id  String?   @db.Uuid
  metadata              Json
  created_at            DateTime  @db.Timestamptz(6)
  created_by            String    @db.VarChar(255)
  updated_at            DateTime  @db.Timestamptz(6)
  updated_by            String    @db.VarChar(255)
  deleted_at            DateTime? @db.Timestamptz(6)
  deleted_by            String?   @db.VarChar(255)
  version               Int

  @@index([tenant_id, employment_id, due_date(sort: Desc)], map: "performance_goal_employment_idx")
  @@index([tenant_id, cycle_id, status], map: "performance_goal_cycle_idx")
  @@index([tenant_id, parent_goal_id], map: "performance_goal_parent_idx")
  @@map("performance_goal")
}

/// An objective beneath a goal, in the OKR shape the specification names.
model PerformanceObjective {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id     String    @db.Uuid
  goal_id       String    @db.Uuid
  title         String    @db.VarChar(255)
  description   String?
  display_order Int       @db.SmallInt
  status        String    @db.VarChar(16)
  created_at    DateTime  @db.Timestamptz(6)
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String    @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)
  version       Int

  @@index([tenant_id, goal_id, display_order], map: "performance_objective_goal_idx")
  @@map("performance_objective")
}

/// A measurable result under an objective.
///
/// Integers with a shared exponent, exactly as money is: 105 with an exponent of -1 is 10.5. A key
/// result measured in a floating-point column would drift, and this is a number somebody is held to.
model PerformanceKeyResult {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  objective_id   String    @db.Uuid
  title          String    @db.VarChar(255)
  unit           String?   @db.VarChar(32)
  start_value    BigInt
  target_value   BigInt
  current_value  BigInt
  value_exponent Int       @db.SmallInt
  display_order  Int       @db.SmallInt
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, objective_id, display_order], map: "performance_key_result_objective_idx")
  @@map("performance_key_result")
}

/// A progress entry. Insert-only: what somebody reported in March is not rewritten in September, and
/// a trigger refuses the attempt from any path.
model PerformanceGoalProgress {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id             String    @db.Uuid
  goal_id               String    @db.Uuid
  key_result_id         String?   @db.Uuid
  progress_basis_points Int
  observed_value        BigInt?
  note                  String?
  evidence_document_id  String?   @db.Uuid
  recorded_at           DateTime  @db.Timestamptz(6)
  recorded_by           String    @db.VarChar(255)
  created_at            DateTime  @db.Timestamptz(6)
  created_by            String    @db.VarChar(255)
  updated_at            DateTime  @db.Timestamptz(6)
  updated_by            String    @db.VarChar(255)
  deleted_at            DateTime? @db.Timestamptz(6)
  deleted_by            String?   @db.VarChar(255)
  version               Int

  @@index([tenant_id, goal_id, recorded_at(sort: Desc)], map: "performance_goal_progress_goal_idx")
  @@map("performance_goal_progress")
}

/// A scheduled evaluation period. Payroll's period/run pair is the precedent.
