// ------------------------------------------------------------------------------------------
// Employment — the relationship between a person and the tenant's workforce (Phase 5).
//
// Three decisions in this section are the ones a reviewer should challenge.
//
//   * `employment` carries **no unit, no position and no cost centre**. A person's organizational
//     placement changes and its past stays answerable, so placement lives entirely in
//     `employment_assignment`, on a timeline (AD-005). A column here would be a second answer,
//     and the second answer is the one that is stale.
//
//   * `employment_number` is **generated by this product**, never supplied by a caller, never
//     reused, and immutable once written. A customer's own reference travels in
//     `external_employee_number` beside it, which is what lets a migration keep its legacy
//     numbers without either of them pretending to be the person's identity (AD-002, ADR-0039).
//
//   * A person may hold **many** employments — rehire is a new employment, never an edited one
//     (AD-004) — but only **one open at a time**, enforced by a partial unique index. That index
//     is what makes a duplicated create fail deterministically rather than quietly producing a
//     second employment for the same human being.
// ------------------------------------------------------------------------------------------

/// One employment relationship between a Person and this tenant. References Person; Person never
/// references Employment (AD-001). Holds no attendance (AD-006), no leave balance (AD-007) and no
/// payroll calculation (AD-008).
model Employment {
  id                       String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                String    @db.Uuid
  person_id                String    @db.Uuid
  /// Generated, tenant-scoped, immutable, never reused. Not the person's identity (ADR-0039).
  employment_number        String    @db.VarChar(64)
  /// The customer's own number, carried through a migration. Optional, and never generated here.
  external_employee_number String?   @db.VarChar(64)
  status                   String    @db.VarChar(32)
  /// A tenant or country-pack code — full time, contract, seasonal. Never a list this product
  /// ships: which classifications exist is a statutory and cultural question (00B).
  employment_type_code     String    @db.VarChar(64)
  employment_category_code String?   @db.VarChar(64)
  employment_class_code    String?   @db.VarChar(64)
  /// The first day this human being ever worked for this tenant. Survives a rehire: it is copied
  /// forward to the new employment, never recomputed, because service-length entitlements in
  /// several of this product's markets are measured from it.
  original_hire_date       DateTime  @db.Date
  /// The first day of *this* employment. Equal to the original hire date for a first employment.
  start_date               DateTime  @db.Date
  end_date                 DateTime? @db.Date
  /// A tenant-supplied code. Resignation, dismissal and end-of-contract carry different statutory
  /// consequences in every market, so the list is never one this product ships (00B).
  end_reason_code          String?   @db.VarChar(64)
  /// Tenant-authored, stored and never interpreted. No rule in the module reads a key.
  metadata                 Json
  created_at               DateTime  @db.Timestamptz(6)
  created_by               String    @db.VarChar(255)
  updated_at               DateTime  @db.Timestamptz(6)
  updated_by               String    @db.VarChar(255)
  deleted_at               DateTime? @db.Timestamptz(6)
  deleted_by               String?   @db.VarChar(255)
  version                  Int

  @@index([tenant_id, status], map: "employment_tenant_status_idx")
  @@index([tenant_id, person_id], map: "employment_tenant_person_idx")
  @@index([tenant_id, start_date], map: "employment_tenant_start_idx")
  @@map("employment")
}

/// Every status transition, appended and never amended. The record rather than the events:
/// "what was this employment's status on that date" must be answerable from the database a
/// consumer can query, not from an event stream a consumer subscribed to after the fact.
model EmploymentStatusRecord {
  id            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id     String    @db.Uuid
  employment_id String    @db.Uuid
  /// Absent on the first record, which is the creation itself.
  from_status   String?   @db.VarChar(32)
  to_status     String    @db.VarChar(32)
  reason_code   String?   @db.VarChar(64)
  note          String?   @db.VarChar(1024)
  effective_from DateTime @db.Timestamptz(6)
  /// Taken from the authenticated context. A caller cannot supply it.
  recorded_by   String    @db.VarChar(255)
  recorded_at   DateTime  @db.Timestamptz(6)
  created_at    DateTime  @db.Timestamptz(6)
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String    @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.VarChar(255)
  version       Int

  @@index([tenant_id, employment_id, effective_from], map: "employment_status_record_employment_idx")
  @@map("employment_status_record")
}

/// Where an employment sits in the organization, and from when. Never edited — a transfer closes
/// one period and opens another, so "which department did this person belong to on that date"
/// keeps exactly one answer.
///
/// There is no work-location column. A unit and a physical place of work are different things,
/// and no authoritative work-location model exists in this product yet; inventing a relationship
/// to `unit_id` would be a false one. ADR-0041 names the extension point.
model EmploymentAssignment {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  employment_id  String    @db.Uuid
  /// `organization`'s unit. Referenced by identity only — no foreign key across a module boundary.
  unit_id        String    @db.Uuid
  position_id    String?   @db.Uuid
  cost_center_id String?   @db.Uuid
  /// `primary` or `secondary`. Never inferred from insertion order (AD-005).
  assignment_type String   @db.VarChar(16)
  /// Full-time equivalent for this assignment alone. A workload share, not a salary fraction.
  fte            Decimal   @db.Decimal(5, 4)
  reason_code    String?   @db.VarChar(64)
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, employment_id, effective_from], map: "employment_assignment_employment_idx")
  @@index([tenant_id, unit_id], map: "employment_assignment_unit_idx")
  @@index([tenant_id, position_id, unit_id], map: "employment_assignment_position_unit_idx")
  @@index([tenant_id, cost_center_id], map: "employment_assignment_center_idx")
  @@map("employment_assignment")
}

/// Who this employment reported to, and from when. A manager is an employment, never a second
/// identity (§16) — which is what makes "who was this person's manager on that date" answerable
/// after both of them have changed jobs.
model EmploymentReportingLine {
  id                   String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id            String    @db.Uuid
  employment_id        String    @db.Uuid
  manager_employment_id String   @db.Uuid
  /// `primary` today. The column a future functional or matrix line arrives through.
  line_type            String    @db.VarChar(16)
  effective_from       DateTime  @db.Timestamptz(6)
  effective_to         DateTime? @db.Timestamptz(6)
