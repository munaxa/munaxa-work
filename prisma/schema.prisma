  @@index([tenant_id, active], map: "learning_instructor_active_idx")
  @@map("learning_instructor")
}


// ---------------------------------------------------------------------------------------------
// Career & Succession (Phase 15)
//
// Career records what an organization *intends* and executes nothing. No model below carries a
// column through which an employment, position, assignment or salary could change (ADR-0072).
//
// Three absences are deliberate and each is a column somebody would reasonably have added: no
// `criticality` (Organization owns it, AD-004), no potential band or nine-box code (Performance
// owns it, ADR-0073), and no readiness score or development-mix verdict (readiness is stated by a
// person and the 70-20-10 rule is NOT VERIFIED, ADR-0074).
//
// Every date here is a civil `@db.Date`. `@db.Timestamptz(6)` appears only on audit columns and on
// `recorded_at`, which genuinely is the instant a row was written.
//
// Cross-module identifiers — `employment_id`, `position_id`, `target_unit_id`,
// `learning_assignment_id` — are plain `@db.Uuid` with no foreign key and no Prisma relation
// (ADR-0042). A foreign key does not provide tenant isolation: PostgreSQL's referential check runs
// without consulting a row-level policy.
// ---------------------------------------------------------------------------------------------

/// A route somebody could follow. Configuration, and the only effective-dated thing in the module.
model CareerPath {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  code           String    @db.VarChar(64)
  name           Json
  description    Json?
  kind           String    @db.VarChar(24)
  status         String    @db.VarChar(16)
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  archived_at    DateTime? @db.Timestamptz(6)
  archived_by    String?   @db.VarChar(255)
  metadata       Json
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, status, effective_from], map: "career_path_status_idx")
  @@map("career_path")
}

/// A stage along a path. `sequence` is an order, **not a gate** — nothing requires stage two before
/// stage three, because prerequisites were never specified (D-17). `target_position_id` is
/// Organization's identifier and nothing else: no title, no grade, no criticality.
model CareerStage {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  path_id            String    @db.Uuid
  sequence           Int       @db.SmallInt
  name               Json
  target_position_id String?   @db.Uuid
  metadata           Json
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@map("career_stage")
}

/// One employment's plan. `path_id` is nullable (D-18): a tenant may plan somebody towards a target
/// stage without committing to a whole published path. A stage may only be named where a path is.
model CareerPlan {
  id               String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id        String    @db.Uuid
  employment_id    String    @db.Uuid
  path_id          String?   @db.Uuid
  current_stage_id String?   @db.Uuid
  target_stage_id  String?   @db.Uuid
  status           String    @db.VarChar(16)
  started_on       DateTime  @db.Date
  target_date      DateTime? @db.Date
  notes            String?   @db.VarChar(4000)
  closed_on        DateTime? @db.Date
  closed_by        String?   @db.VarChar(255)
  metadata         Json
  created_at       DateTime  @db.Timestamptz(6)
  created_by       String    @db.VarChar(255)
  updated_at       DateTime  @db.Timestamptz(6)
  updated_by       String    @db.VarChar(255)
  deleted_at       DateTime? @db.Timestamptz(6)
  deleted_by       String?   @db.VarChar(255)
  version          Int

  @@index([tenant_id, employment_id, status], map: "career_plan_employment_idx")
  @@map("career_plan")
}

/// A pool a tenant named. **Nothing in this product branches on a pool's kind**, and no column is
/// derived from Performance's potential band (ADR-0073).
model CareerTalentPool {
  id          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id   String    @db.Uuid
  code        String    @db.VarChar(64)
  name        Json
  description Json?
  kind        String    @db.VarChar(24)
  status      String    @db.VarChar(16)
  closed_at   DateTime? @db.Timestamptz(6)
  closed_by   String?   @db.VarChar(255)
  metadata    Json
  created_at  DateTime  @db.Timestamptz(6)
  created_by  String    @db.VarChar(255)
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String    @db.VarChar(255)
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.VarChar(255)
  version     Int

  @@map("career_talent_pool")
}

/// A period somebody was in a pool. **Removal ends the period; it never deletes the row** — a
/// succession review a year later asks who was invested in and what became of them. Both ends are
/// inclusive.
model CareerPoolMembership {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  talent_pool_id String    @db.Uuid
  employment_id  String    @db.Uuid
  from_date      DateTime  @db.Date
  to_date        DateTime? @db.Date
  added_by       String    @db.VarChar(255)
  added_reason   String?   @db.VarChar(1024)
  removed_by     String?   @db.VarChar(255)
  removed_reason String?   @db.VarChar(1024)
  metadata       Json
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, talent_pool_id, from_date], map: "career_pool_membership_pool_idx")
  @@index([tenant_id, employment_id, from_date], map: "career_pool_membership_employment_idx")
  @@map("career_pool_membership")
}

/// A tenant's own ladder. `ordinal` orders the levels least to most ready so a screen can sort them.
/// **It is not a score and is never published as one** (ADR-0074).
model CareerReadinessLevel {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id  String    @db.Uuid
  code       String    @db.VarChar(64)
  name       Json
  ordinal    Int       @db.SmallInt
  active     Boolean
  metadata   Json
  created_at DateTime  @db.Timestamptz(6)
  created_by String    @db.VarChar(255)
  updated_at DateTime  @db.Timestamptz(6)
  updated_by String    @db.VarChar(255)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.VarChar(255)
  version    Int

  @@map("career_readiness_level")
}

/// The plan **for** a position, not a second record of the position (D-3). `position_id` is
/// Organization's identifier; there is no criticality column. `review_on` is a day somebody chose to
/// look again — **nothing reminds them**, because `JobPort` has no adapter.
model CareerSuccessionPlan {
  id          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id   String    @db.Uuid
  position_id String    @db.Uuid
  status      String    @db.VarChar(16)
  review_on   DateTime? @db.Date
  notes       String?   @db.VarChar(4000)
  archived_at DateTime? @db.Timestamptz(6)
  archived_by String?   @db.VarChar(255)
  metadata    Json
  created_at  DateTime  @db.Timestamptz(6)
  created_by  String    @db.VarChar(255)
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String    @db.VarChar(255)
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.VarChar(255)
  version     Int

  @@index([tenant_id, status, position_id], map: "career_succession_plan_status_idx")
  @@map("career_succession_plan")
}

/// A nomination. `rank` is an order a human put the bench in — **not a score, and nothing computes
/// it**. Confirmation carries its own actor and day, and `system:auto-approval` is refused by check
/// constraint. **Withdrawal is a state, never a delete.**
model CareerSuccessor {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  succession_plan_id String    @db.Uuid
  employment_id      String    @db.Uuid
  readiness_level_id String?   @db.Uuid
  rank               Int?      @db.SmallInt
  status             String    @db.VarChar(16)
  nominated_on       DateTime  @db.Date
  nominated_by       String    @db.VarChar(255)
  confirmed_on       DateTime? @db.Date
  confirmed_by       String?   @db.VarChar(255)
  withdrawn_on       DateTime? @db.Date
  withdrawn_by       String?   @db.VarChar(255)
  withdrawal_reason  String?   @db.VarChar(1024)
  metadata           Json
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@index([tenant_id, succession_plan_id, status], map: "career_successor_plan_idx")
  @@index([tenant_id, employment_id, status], map: "career_successor_employment_idx")
  @@map("career_successor")
}

/// One person's statement that somebody is at one level, on one day. **Append-only** (D-14): a
/// trigger refuses every update and delete, because a correction is a new assessment. There is no
/// score column, no weight and no reference to the inputs a derivation would have used.
model CareerReadinessAssessment {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  employment_id      String    @db.Uuid
  readiness_level_id String    @db.Uuid
  position_id        String?   @db.Uuid
  succession_plan_id String?   @db.Uuid
  assessed_on        DateTime  @db.Date
  assessed_by        String    @db.VarChar(255)
  rationale          String?   @db.VarChar(4000)
  recorded_at        DateTime  @db.Timestamptz(6)
  metadata           Json
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@index([tenant_id, employment_id, assessed_on(sort: Desc)], map: "career_readiness_assessment_employment_idx")
  @@map("career_readiness_assessment")
}

/// **Joint ownership is NOT VERIFIED** (D-9). This product has no principal-to-employment resolution
/// (ADR-0032), so the columns say what is true: an administrator *recorded* that each party
/// acknowledged, and the recorder is the authenticated actor. A column named `employee_signed_by`
/// would claim something the platform cannot deliver.
model CareerDevelopmentPlan {
  id                                   String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                            String    @db.Uuid
  employment_id                        String    @db.Uuid
  career_plan_id                       String?   @db.Uuid
  cycle_label                          String?   @db.VarChar(255)
  status                               String    @db.VarChar(16)
  started_on                           DateTime  @db.Date
  target_date                          DateTime? @db.Date
  employee_acknowledged_on             DateTime? @db.Date
  employee_acknowledgement_recorded_by String?   @db.VarChar(255)
  manager_acknowledged_on              DateTime? @db.Date
  manager_acknowledgement_recorded_by  String?   @db.VarChar(255)
  closed_on                            DateTime? @db.Date
  closed_by                            String?   @db.VarChar(255)
  metadata                             Json
  created_at                           DateTime  @db.Timestamptz(6)
  created_by                           String    @db.VarChar(255)
  updated_at                           DateTime  @db.Timestamptz(6)
  updated_by                           String    @db.VarChar(255)
  deleted_at                           DateTime? @db.Timestamptz(6)
  deleted_by                           String?   @db.VarChar(255)
  version                              Int

  @@index([tenant_id, employment_id, status], map: "career_development_plan_employment_idx")
  @@map("career_development_plan")
}

/// **A course item is a reference to Learning, and Career keeps no status for it** (ADR-0073).
/// `learning_assignment_id` is present exactly when `kind = 'course'` and is the whole of what
/// Career stores about it. `category` is **counted and never validated**: the 70-20-10 model has no
/// rule attached to it, so there is no target, tolerance or balance verdict here (D-12).
model CareerDevelopmentItem {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  development_plan_id    String    @db.Uuid
  category               String    @db.VarChar(16)
  kind                   String    @db.VarChar(24)
  title                  String    @db.VarChar(255)
  learning_assignment_id String?   @db.Uuid
  target_date            DateTime? @db.Date
  status                 String    @db.VarChar(16)
  completed_on           DateTime? @db.Date
  completed_by           String?   @db.VarChar(255)
  metadata               Json
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@index([tenant_id, development_plan_id, category], map: "career_development_item_plan_idx")
  @@map("career_development_item")
}

/// **A suggestion, and nothing that moves anybody.** `accepted` means a named person agreed the move
/// is a good idea — no employment changes, no assignment is written, nobody is told (ADR-0072).
/// There is no `effective_date` and no `assignment_id`, because there is nothing for either to point
/// at. **`expired` is never stored** (D-13): it is derived from `valid_until` and the day somebody
/// asked, and a check constraint refuses it as a column value.
model CareerMobilityRecommendation {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  employment_id      String    @db.Uuid
  kind               String    @db.VarChar(32)
  target_position_id String?   @db.Uuid
  target_unit_id     String?   @db.Uuid
  rationale          String?   @db.VarChar(4000)
  status             String    @db.VarChar(16)
  recommended_on     DateTime  @db.Date
  recommended_by     String    @db.VarChar(255)
  valid_until        DateTime? @db.Date
  decided_on         DateTime? @db.Date
  decided_by         String?   @db.VarChar(255)
  decision_note      String?   @db.VarChar(1024)
  metadata           Json
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@index([tenant_id, employment_id, status], map: "career_mobility_recommendation_employment_idx")
  @@map("career_mobility_recommendation")
}

// ------------------------------------------------------------------------------------------------
// Enterprise Workflow & Approvals (Phase 16A)
//
// Workflow owns process and owns no business data. A definition names what it decides by an opaque
// `subject_type` and knows nothing else about it (AD-001); a published version is immutable and an
// instance copies its steps (AD-003); a decision and a history entry are append-only, refused at the
// table by a trigger.
//
// Absent on purpose: no role or group, no SLA, no escalation, no branching condition, no tally and
// no `pattern` — in 16A a single approval *is* a one-step sequential approval, so a pattern column
// would carry two values with identical behaviour.
// ------------------------------------------------------------------------------------------------

/// A reusable process a tenant configured. `subject_type` is the opaque string a business module
/// supplies through `ApprovalPort`; its shape is checked and its meaning is not, because a list of
/// legal values here would be a list of business modules.
model WorkflowDefinition {
  id           String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id    String    @db.Uuid
  code         String    @db.VarChar(64)
  name         Json
  description  Json?
  subject_type String    @db.VarChar(128)
  status       String    @db.VarChar(16)
  retired_at   DateTime? @db.Timestamptz(6)
  retired_by   String?   @db.VarChar(255)
  metadata     Json
  created_at   DateTime  @db.Timestamptz(6)
  created_by   String    @db.VarChar(255)
  updated_at   DateTime  @db.Timestamptz(6)
  updated_by   String    @db.VarChar(255)
  deleted_at   DateTime? @db.Timestamptz(6)
  deleted_by   String?   @db.VarChar(255)
  version      Int

  @@index([tenant_id, subject_type, status], map: "workflow_definition_subject_idx")
  @@map("workflow_definition")
}

/// A version of a definition, and the row AD-003 is about. Nothing constrains a definition to one
/// published version: neither the domain nor the approved plan states that rule, and which published
/// version a new instance uses is the application's selection.
model WorkflowVersion {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  definition_id  String    @db.Uuid
  version_number Int
  status         String    @db.VarChar(16)
  published_at   DateTime? @db.Timestamptz(6)
  published_by   String?   @db.VarChar(255)
  metadata       Json
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@map("workflow_version")
}

/// A named list of memberships a tenant maintains (Phase 16B). Not a directory: no query behind it,
/// no nesting, no inheritance, no role semantics — and no lifecycle, which is why there is no
/// `status` column. Resolved into individual steps when an instance starts, and never read again.
model WorkflowApprovalGroup {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id  String    @db.Uuid
  code       String    @db.VarChar(64)
  name       Json
  metadata   Json
  created_at DateTime  @db.Timestamptz(6)
  created_by String    @db.VarChar(255)
  updated_at DateTime  @db.Timestamptz(6)
  updated_by String    @db.VarChar(255)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.VarChar(255)
  version    Int

  /// Not a second identity — `id` is already unique. It exists so a child row's foreign key can name
  /// `(id, tenant_id)` and be structurally unable to reach a group in another tenant.
  @@unique([id, tenant_id], map: "workflow_approval_group_tenant_key")
  @@map("workflow_approval_group")
}

/// One membership's place in one group. `membership_id` is Identity's identifier held as a value,
/// with no foreign key (ADR-0042); the group reference is composite so it carries the tenant.
model WorkflowApprovalGroupMember {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id         String    @db.Uuid
  approval_group_id String    @db.Uuid
  membership_id     String    @db.Uuid
  added_at          DateTime  @db.Timestamptz(6)
  metadata          Json
  created_at        DateTime  @db.Timestamptz(6)
  created_by        String    @db.VarChar(255)
  updated_at        DateTime  @db.Timestamptz(6)
  updated_by        String    @db.VarChar(255)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_by        String?   @db.VarChar(255)
  version           Int

  @@index([tenant_id, approval_group_id, membership_id], map: "workflow_approval_group_member_group_idx")
  @@map("workflow_approval_group_member")
}

/// One step of a version: who is asked, and where in the order. `ordinal` is `Int` rather than a
/// small integer deliberately — AD-004 forbids a hardcoded approval limit.
///
/// Since Phase 16B an ordinal is a **branch** rather than a position: several templates may share
/// one, and all of them are asked at the same moment. `approver_kind` decides which of the two
/// approver columns is present, and exactly one is.
model WorkflowStepTemplate {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  workflow_version_id    String    @db.Uuid
  ordinal                Int
  name                   Json
  approver_kind          String    @db.VarChar(16)
  approver_membership_id String?   @db.Uuid
  approver_group_id      String?   @db.Uuid
  branch_rule            String?   @db.VarChar(16)
  quorum                 Int?
  condition              Json?
  metadata               Json
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@map("workflow_step_template")
}

/// A running approval. This *is* the specification's Approval Request: its identifier is the
/// `approvalId` the four reserved `approval_id` columns across Recruitment, Leave, Onboarding and
/// Attendance are shaped for. `context` is stored for audit and read by nothing in 16A.
model WorkflowInstance {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  definition_id              String    @db.Uuid
  workflow_version_id        String    @db.Uuid
  subject_type               String    @db.VarChar(128)
  subject_id                 String    @db.VarChar(64)
  requested_by_membership_id String    @db.Uuid
  status                     String    @db.VarChar(16)
  started_at                 DateTime  @db.Timestamptz(6)
  completed_at               DateTime? @db.Timestamptz(6)
  cancelled_by               String?   @db.VarChar(255)
  cancellation_reason        String?   @db.VarChar(1024)
  correlation_id             String    @db.Uuid
  context                    Json
  metadata                   Json
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@index([tenant_id, subject_type, subject_id, status], map: "workflow_instance_subject_idx")
  @@index([tenant_id, status, started_at, id], map: "workflow_instance_status_idx")
  @@map("workflow_instance")
}

/// One step of a running instance, copied from a template at creation. No column references the
/// template it came from — that is what makes the copy a copy (AD-003).
///
/// `approver_kind` is always `membership` here, and that is the point of the group snapshot: a
/// template may name a group, a running step never does. `source_group_id` records which list the
/// person came from and is **provenance rather than a reference** — no foreign key, so editing a
/// group cannot reach an approval already under way.
model WorkflowStep {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  instance_id            String    @db.Uuid
  ordinal                Int
  approver_kind          String    @db.VarChar(16)
  approver_membership_id String    @db.Uuid
  status                 String    @db.VarChar(16)
  source_group_id        String?   @db.Uuid
  branch_rule            String?   @db.VarChar(16)
  quorum                 Int?
  condition              Json?
  metadata               Json
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@map("workflow_step")
}

/// What an approver said, written once and refused every update and delete by a trigger. Two
/// memberships, never one: the delegate who decided, and the approver whose authority they used.
model WorkflowDecision {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  instance_id                String    @db.Uuid
  step_id                    String    @db.Uuid
  decision                   String    @db.VarChar(16)
  decided_by_membership_id   String    @db.Uuid
  authority                  String    @db.VarChar(16)
  on_behalf_of_membership_id String?   @db.Uuid
  decided_at                 DateTime  @db.Timestamptz(6)
  comment                    String?   @db.VarChar(1024)
  metadata                   Json
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@index([tenant_id, decided_by_membership_id, id], map: "workflow_decision_decider_idx")
  @@index([tenant_id, instance_id, id], map: "workflow_decision_instance_idx")
  @@map("workflow_decision")
}

/// How an instance got where it is: Workflow's audit of routing, never a business fact. Append-only,
/// and carrying no comment or rationale — those live on the decision, where a permission decides who
/// may read them.
model WorkflowHistory {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  instance_id                String    @db.Uuid
  event                      String    @db.VarChar(32)
  occurred_at                DateTime  @db.Timestamptz(6)
  step_id                    String?   @db.Uuid
  ordinal                    Int?
  actor_membership_id        String?   @db.Uuid
  on_behalf_of_membership_id String?   @db.Uuid
  metadata                   Json
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@index([tenant_id, instance_id, occurred_at, id], map: "workflow_history_instance_idx")
  @@map("workflow_history")
}
