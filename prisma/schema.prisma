// ---------------------------------------------------------------------------------------------
// Attendance (Phase 8) — the highest-volume domain in the product.
//
// Four rules run through every model below.
//
//   * **A raw event is immutable.** `attendance_time_event` is inserted and read. No repository
//     offers an update, a correction never rewrites one, and the audit trail is the sequence
//     itself.
//   * **An attendance day is a derivation, not a fact somebody recorded.** It stores the inputs it
//     was computed from — schedule, shift, policy, roster, calculation version, a digest of the
//     event set — so the same inputs reproduce it and a changed input is detectable without an
//     event ever being delivered (ADR-0053).
//   * **No employment fact is copied.** No employee number, no employment status, no contracted
//     hours, no manager, no person. `employment_id` is a reference with a foreign key, and every
//     employment question is asked of Employment as at the attendance date (ADR-0051).
//   * **No money, anywhere.** Attendance produces candidate minutes; what time is worth is
//     Compensation's and Payroll's (ADR-0054).
// ---------------------------------------------------------------------------------------------

/// One raw time event, exactly as it was captured. Inserted and read; never updated.
model AttendanceTimeEvent {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  /// Employment's, by identifier and by foreign key. Attendance never references a Person.
  employment_id      String    @db.Uuid
  kind               String    @db.VarChar(24)
  source             String    @db.VarChar(24)
  /// The originating system's own identifier, opaque. Never parsed, only stored and compared.
  source_reference   String?   @db.VarChar(128)
  device_reference   String?   @db.VarChar(128)
  /// The deduplication identity. A partial unique index on (tenant_id, event_key) is what makes
  /// ingestion idempotent under device retries, mobile sync and re-run imports.
  event_key          String    @db.VarChar(200)
  /// The instant the domain treats as authoritative.
  occurred_at        DateTime  @db.Timestamptz(6)
  /// What the client claimed, and when the server accepted it. Kept apart even when equal.
  reported_at        DateTime  @db.Timestamptz(6)
  received_at        DateTime  @db.Timestamptz(6)
  /// reported_at − received_at. Divergence is data, not an error to discard.
  clock_skew_seconds Int
  captured_offline   Boolean
  /// The IANA zone resolved at ingestion, stored so a recalculation years later uses the zone
  /// that applied then rather than the zone that applies now.
  zone               String    @db.VarChar(64)
  /// The civil date this event belongs to, resolved through the schedule (never a UTC truncation).
  attendance_date    DateTime  @db.Date
  /// Set only on a correction event. The original is never touched.
  supersedes_event_id String?  @db.Uuid
  /// Punch location evidence, captured only where the tenant enables it for that source. It is
  /// not an authoritative work location and there is no geofence verdict here (ADR-0055).
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  location_accuracy_metres Int?
  note               String?   @db.VarChar(1024)
  import_batch_id    String?   @db.Uuid
  metadata           Json
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@index([tenant_id, employment_id, attendance_date], map: "attendance_time_event_day_idx")
  @@index([tenant_id, attendance_date], map: "attendance_time_event_date_idx")
  @@index([tenant_id, source, received_at], map: "attendance_time_event_source_idx")
  @@map("attendance_time_event")
}

