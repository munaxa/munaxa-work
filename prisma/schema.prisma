/// The due dates are configuration and **nothing fires them**: `JobPort` has no adapter, so overdue
/// work is a query somebody runs rather than a sweep that happens (D-22).
model PerformanceCycle {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  code                   String    @db.VarChar(64)
  name                   Json
  review_template_id     String    @db.Uuid
  kind                   String    @db.VarChar(24)
  status                 String    @db.VarChar(16)
  period_start           DateTime  @db.Date
  period_end             DateTime  @db.Date
  self_assessment_due    DateTime? @db.Date
  manager_assessment_due DateTime? @db.Date
  peer_assessment_due    DateTime? @db.Date
  calibration_due        DateTime? @db.Date
  opened_at              DateTime? @db.Timestamptz(6)
  closed_at              DateTime? @db.Timestamptz(6)
  closed_by              String?   @db.VarChar(255)
  cancelled_at           DateTime? @db.Timestamptz(6)
  cancellation_reason    String?   @db.VarChar(1024)
  metadata               Json
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@unique([tenant_id, code], map: "performance_cycle_code_idx")
  @@index([tenant_id, status, period_end(sort: Desc)], map: "performance_cycle_status_idx")
  @@map("performance_cycle")
}

/// One employment's review within a cycle. Enrolment and review are the same row.
///
/// `calculated_score` is what the scoring engine produced and is **never overwritten**. `final_score`
/// is what the review is rated at — the calculated score unless a calibration decision overrode it,
/// and that decision holds both values (D-6).
model PerformanceReview {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  cycle_id                   String    @db.Uuid
  employment_id              String    @db.Uuid
  /// The manager at enrolment. The manager at completion is snapshotted separately (D-13).
  manager_employment_id      String?   @db.Uuid
  rating_scale_id            String    @db.Uuid
  status                     String    @db.VarChar(24)
  calculated_score           Int?
  calculated_rating_level_id String?   @db.Uuid
  final_score                Int?
  final_rating_level_id      String?   @db.Uuid
  calibrated                 Boolean
  scored_at                  DateTime? @db.Timestamptz(6)
  completed_at               DateTime? @db.Timestamptz(6)
  /// A named human. `system:auto-approval` is refused by a check constraint.
  completed_by               String?   @db.VarChar(255)
  archived_at                DateTime? @db.Timestamptz(6)
  metadata                   Json
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@unique([tenant_id, cycle_id, employment_id], map: "performance_review_participant_idx")
  @@index([tenant_id, manager_employment_id, cycle_id, status], map: "performance_review_manager_idx")
  @@index([tenant_id, employment_id, completed_at(sort: Desc)], map: "performance_review_employment_idx")
  @@map("performance_review")
}

/// Who was asked to assess this review, and in what capacity.
///
/// 360° is a set of reviewer roles here rather than a parallel system (D-2): a peer, a direct report
/// and a skip-level manager are three roles on one review, not three feature areas.
model PerformanceReviewerAssignment {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  review_id              String    @db.Uuid
  reviewer_employment_id String    @db.Uuid
  role                   String    @db.VarChar(24)
  status                 String    @db.VarChar(16)
  requested_at           DateTime  @db.Timestamptz(6)
  requested_by           String    @db.VarChar(255)
  responded_at           DateTime? @db.Timestamptz(6)
  decline_reason         String?   @db.VarChar(1024)
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@unique([tenant_id, review_id, reviewer_employment_id, role], map: "performance_reviewer_assignment_idx")
  @@index([tenant_id, reviewer_employment_id, status], map: "performance_reviewer_assignment_reviewer_idx")
  @@map("performance_reviewer_assignment")
}

/// One assessor's assessment of one review. Separate rows per assessor and kind, never states of one
/// record (D-10): a manager cannot overwrite a self-assessment because there is no column to do it
/// in. Immutable from submission, in the domain, the application and a trigger.
model PerformanceAssessment {
  id                     String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id              String    @db.Uuid
  review_id              String    @db.Uuid
  reviewer_assignment_id String?   @db.Uuid
  /// From the authenticated context at submission, never from a request body.
  assessor_employment_id String    @db.Uuid
  assessment_kind        String    @db.VarChar(24)
  status                 String    @db.VarChar(16)
  goal_score             Int?
  competency_score       Int?
  overall_score          Int?
  rating_level_id        String?   @db.Uuid
  overall_comment        String?
  strengths              String?
  development_areas      String?
  submitted_at           DateTime? @db.Timestamptz(6)
  submitted_by           String?   @db.VarChar(255)
  created_at             DateTime  @db.Timestamptz(6)
  created_by             String    @db.VarChar(255)
  updated_at             DateTime  @db.Timestamptz(6)
  updated_by             String    @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)
  deleted_by             String?   @db.VarChar(255)
  version                Int

  @@unique([tenant_id, review_id, assessor_employment_id, assessment_kind], map: "performance_assessment_assessor_idx")
  @@index([tenant_id, review_id, assessment_kind], map: "performance_assessment_review_idx")
  @@map("performance_assessment")
}

/// One line of an assessment: a goal scored, or a competency rated.
///
/// `excluded` and `exclusion_reason` are D-6's fifth decision made into columns. Missing, incomplete
/// and cancelled work is excluded from the denominator and recorded as excluded, because silently
/// converting it to a zero would rate somebody down for work nobody assessed.
model PerformanceAssessmentItem {
  id                  String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id           String    @db.Uuid
  assessment_id       String    @db.Uuid
  item_kind           String    @db.VarChar(16)
  goal_id             String?   @db.Uuid
  competency_id       String?   @db.Uuid
  score               Int?
  rating_level_id     String?   @db.Uuid
  weight_basis_points Int?
  comment             String?
  excluded            Boolean
  exclusion_reason    String?   @db.VarChar(32)
  created_at          DateTime  @db.Timestamptz(6)
  created_by          String    @db.VarChar(255)
  updated_at          DateTime  @db.Timestamptz(6)
  updated_by          String    @db.VarChar(255)
  deleted_at          DateTime? @db.Timestamptz(6)
  deleted_by          String?   @db.VarChar(255)
  version             Int

  @@index([tenant_id, assessment_id, goal_id], map: "performance_assessment_item_goal_idx")
  @@index([tenant_id, assessment_id, competency_id], map: "performance_assessment_item_competency_idx")
  @@map("performance_assessment_item")
}

/// What each component of the final score contributed, and the arithmetic that produced it.
///
/// A rating somebody disagrees with is a conversation, and a conversation needs the working: the
/// component weight, its aggregate, the denominator it was divided by, and — where a component did
/// not participate — the reason it was left out.
model PerformanceReviewComponentScore {
  id                       String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                String    @db.Uuid
  review_id                String    @db.Uuid
  component                String    @db.VarChar(24)
  weight_basis_points      Int
  score                    Int?
  included                 Boolean
  exclusion_reason         String?   @db.VarChar(32)
  /// The sum of the weights that actually participated, in basis points.
  denominator_basis_points Int
  contributed_score        Int?
  /// The goals or competencies that left this component's denominator, each with its reason.
  /// Stored rather than derived: the working explains a rating years later, and deriving it from
  /// rows that may since have changed would defeat the point.
  excluded_items           Json
  calculated_at            DateTime  @db.Timestamptz(6)
  created_at               DateTime  @db.Timestamptz(6)
  created_by               String    @db.VarChar(255)
  updated_at               DateTime  @db.Timestamptz(6)
  updated_by               String    @db.VarChar(255)
  deleted_at               DateTime? @db.Timestamptz(6)
  deleted_by               String?   @db.VarChar(255)
  version                  Int

  @@unique([tenant_id, review_id, component], map: "performance_review_component_score_idx")
  @@map("performance_review_component_score")
}

/// A meeting at which a group of reviews is compared before any of them is completed.
model PerformanceCalibrationSession {
  id                   String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id            String    @db.Uuid
  cycle_id             String    @db.Uuid
  code                 String    @db.VarChar(64)
  name                 Json
  status               String    @db.VarChar(16)
  organization_unit_id String?   @db.Uuid
  scheduled_for        DateTime? @db.Timestamptz(6)
  facilitator          String?   @db.VarChar(255)
  opened_at            DateTime? @db.Timestamptz(6)
  concluded_at         DateTime? @db.Timestamptz(6)
  concluded_by         String?   @db.VarChar(255)
  created_at           DateTime  @db.Timestamptz(6)
  created_by           String    @db.VarChar(255)
  updated_at           DateTime  @db.Timestamptz(6)
  updated_by           String    @db.VarChar(255)
  deleted_at           DateTime? @db.Timestamptz(6)
  deleted_by           String?   @db.VarChar(255)
  version              Int

  @@unique([tenant_id, cycle_id, code], map: "performance_calibration_session_code_idx")
  @@map("performance_calibration_session")
}

/// What a calibration session decided about one review.
///
/// The original score and rating are kept alongside the calibrated ones, with the actor, the moment
/// and the reason. The calibrated value becomes effective; this row is the immutable record of what
/// it was before (D-6's seventh decision). A reason is not optional.
model PerformanceCalibrationDecision {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  calibration_session_id     String    @db.Uuid
  review_id                  String    @db.Uuid
  original_score             Int?
  original_rating_level_id   String?   @db.Uuid
  calibrated_score           Int
  calibrated_rating_level_id String    @db.Uuid
  reason                     String    @db.VarChar(1024)
  decided_at                 DateTime  @db.Timestamptz(6)
  decided_by                 String    @db.VarChar(255)
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@unique([tenant_id, calibration_session_id, review_id], map: "performance_calibration_decision_idx")
  @@index([tenant_id, review_id, decided_at(sort: Desc)], map: "performance_calibration_decision_review_idx")
  @@map("performance_calibration_decision")
}

/// The nine-box placement: performance against potential, for one employment in one cycle.
///
/// Published as a **recommendation**. It changes no employment, triggers no promotion and writes to
/// no other module; Career & Succession (Phase 15) may pull it (D-17).
model PerformanceTalentPlacement {
  id               String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id        String    @db.Uuid
  cycle_id         String    @db.Uuid
  review_id        String    @db.Uuid
  employment_id    String    @db.Uuid
  /// Derived from the review's rating.
  performance_band Int       @db.SmallInt
  /// A human judgement, which is why it carries an assessor and a rationale.
  potential_band   Int       @db.SmallInt
  box_code         String    @db.VarChar(16)
  rationale        String?
  placed_at        DateTime  @db.Timestamptz(6)
  placed_by        String    @db.VarChar(255)
  created_at       DateTime  @db.Timestamptz(6)
  created_by       String    @db.VarChar(255)
  updated_at       DateTime  @db.Timestamptz(6)
  updated_by       String    @db.VarChar(255)
  deleted_at       DateTime? @db.Timestamptz(6)
  deleted_by       String?   @db.VarChar(255)
  version          Int

  @@unique([tenant_id, cycle_id, employment_id], map: "performance_talent_placement_idx")
  @@index([tenant_id, cycle_id, box_code], map: "performance_talent_placement_box_idx")
  @@map("performance_talent_placement")
}

/// Feedback given outside a review.
///
/// `performance_feedback`, never a bare `feedback`: Recruitment already owns interview feedback with
/// its own states and meaning (D-20). Insert-only — withdrawal is a soft delete, which leaves every
/// word of it in place. There is no `anonymous` visibility, because this table cannot provide one.
model PerformanceFeedback {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id             String    @db.Uuid
  subject_employment_id String    @db.Uuid
  author_employment_id  String    @db.Uuid
  kind                  String    @db.VarChar(24)
  visibility            String    @db.VarChar(16)
  body                  String
  related_goal_id       String?   @db.Uuid
  related_review_id     String?   @db.Uuid
  requested_by          String?   @db.VarChar(255)
  given_at              DateTime  @db.Timestamptz(6)
  created_at            DateTime  @db.Timestamptz(6)
  created_by            String    @db.VarChar(255)
  updated_at            DateTime  @db.Timestamptz(6)
  updated_by            String    @db.VarChar(255)
  deleted_at            DateTime? @db.Timestamptz(6)
  deleted_by            String?   @db.VarChar(255)
  version               Int

  @@index([tenant_id, subject_employment_id, given_at(sort: Desc)], map: "performance_feedback_subject_idx")
  @@index([tenant_id, author_employment_id, given_at(sort: Desc)], map: "performance_feedback_author_idx")
  @@map("performance_feedback")
}

/// What a completed review must survive: a manager change, a department move, a competency
/// redefinition, a rating-scale change, a goal redefinition and a position change.
///
/// Written once at completion and immutable afterwards. It holds **no person's name and no pay
/// figure** — a snapshot is the inputs to a decision, not a copy of the database (ADR-0064).
model PerformanceReviewSnapshot {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id             String    @db.Uuid
  review_id             String    @db.Uuid
  /// The manager at completion, which a transfer afterwards does not change (D-13).
  manager_employment_id String?   @db.Uuid
  reviewers             Json
  placement             Json
  rating_scale          Json
  competency_framework  Json?
  goals                 Json
  component_scores      Json
  calculation           Json
  taken_at              DateTime  @db.Timestamptz(6)
  taken_by              String    @db.VarChar(255)
  created_at            DateTime  @db.Timestamptz(6)
  created_by            String    @db.VarChar(255)
  updated_at            DateTime  @db.Timestamptz(6)
  updated_by            String    @db.VarChar(255)
  deleted_at            DateTime? @db.Timestamptz(6)
  deleted_by            String?   @db.VarChar(255)
  version               Int

  @@unique([tenant_id, review_id], map: "performance_review_snapshot_review_idx")
  @@map("performance_review_snapshot")
}

// ================================================================================================
// Learning and development (Phase 14A). Twelve tables: the catalogue and its versions, paths,
// mandatory rules, assignments, enrolments, assessments and certifications.
//
// Two absences are deliberate and worth stating in the schema rather than leaving to be noticed.
// There is no `expired` and no `overdue` column — both are functions of a date and today, derived
// on read, because nothing in this repository moves a flag overnight (ADR-0070, ADR-0071). And
// there is no session, capacity, waitlist or seat: those are Phase 14B, and a column left ready for
// them would be schema claiming a capability nobody built.
// ================================================================================================

/// A tenant's own filing for its courses. No rule in this product reads it (AD-003).
model LearningCourseCategory {
  id          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id   String    @db.Uuid
  code        String    @db.VarChar(64)
  name        Json
  description Json?
  metadata    Json
  created_at  DateTime  @db.Timestamptz(6)
  created_by  String    @db.VarChar(255)
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String    @db.VarChar(255)
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.VarChar(255)
  version     Int

  @@map("learning_course_category")
}

/// A course's stable identity. What it teaches lives in its versions, so an enrolment pinned to one
/// still names what was completed after somebody rewrites the syllabus.
model LearningCourse {
  id                 String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id          String    @db.Uuid
  code               String    @db.VarChar(64)
  name               Json
  description        Json?
  category_id        String?   @db.Uuid
  /// A label for the mode a course was designed for. It schedules nothing in Phase 14A.
  delivery           String    @db.VarChar(24)
  status             String    @db.VarChar(16)
  current_version_id String?   @db.Uuid
  archived_at        DateTime? @db.Timestamptz(6)
  archived_by        String?   @db.VarChar(255)
  metadata           Json
  created_at         DateTime  @db.Timestamptz(6)
  created_by         String    @db.VarChar(255)
  updated_at         DateTime  @db.Timestamptz(6)
  updated_by         String    @db.VarChar(255)
  deleted_at         DateTime? @db.Timestamptz(6)
  deleted_by         String?   @db.VarChar(255)
  version            Int

  @@index([tenant_id, status, code], map: "learning_course_status_idx")
  @@map("learning_course")
}

/// One version of a course. Insert-only, enforced by a trigger: correcting a course publishes
/// version 4 rather than rewriting version 3 (AD-004).
model LearningCourseVersion {
  id                         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                  String    @db.Uuid
  course_id                  String    @db.Uuid
  version_number             Int
  title                      Json
  objectives                 Json?
  /// An opaque key. StoragePort has no adapter: no upload, no download, no URL.
  content_reference          String?   @db.VarChar(1024)
  duration_minutes           Int?
  /// The tenant's configuration. It does not say what passing means — nothing here does.
  requires_assessment        Boolean
  certification_valid_months Int?
  published_at               DateTime  @db.Timestamptz(6)
  published_by               String    @db.VarChar(255)
  metadata                   Json
  created_at                 DateTime  @db.Timestamptz(6)
  created_by                 String    @db.VarChar(255)
  updated_at                 DateTime  @db.Timestamptz(6)
  updated_by                 String    @db.VarChar(255)
  deleted_at                 DateTime? @db.Timestamptz(6)
  deleted_by                 String?   @db.VarChar(255)
  version                    Int

  @@unique([tenant_id, course_id, version_number], map: "learning_course_version_number_idx")
  @@index([tenant_id, course_id, version_number(sort: Desc)], map: "learning_course_version_course_idx")
  @@map("learning_course_version")
}

/// What a course version asks somebody to demonstrate. A kind, a title, and whether it is required
/// — no pass mark, no weight, no attempt limit and no total, because none was ever specified.
model LearningAssessment {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id         String    @db.Uuid
  course_version_id String    @db.Uuid
  title             Json
  kind              String    @db.VarChar(24)
  required          Boolean
  metadata          Json
  created_at        DateTime  @db.Timestamptz(6)
  created_by        String    @db.VarChar(255)
  updated_at        DateTime  @db.Timestamptz(6)
  updated_by        String    @db.VarChar(255)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_by        String?   @db.VarChar(255)
  version           Int

  @@index([tenant_id, course_version_id], map: "learning_assessment_version_idx")
  @@map("learning_assessment")
}

/// Courses a tenant grouped together. A path recommends; it never certifies (AD-002).
model LearningPath {
  id          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id   String    @db.Uuid
  code        String    @db.VarChar(64)
  name        Json
  description Json?
  /// A label a tenant chose. Nothing in this module branches on it (AD-003).
  kind        String    @db.VarChar(24)
  status      String    @db.VarChar(16)
  archived_at DateTime? @db.Timestamptz(6)
  archived_by String?   @db.VarChar(255)
  metadata    Json
  created_at  DateTime  @db.Timestamptz(6)
  created_by  String    @db.VarChar(255)
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String    @db.VarChar(255)
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.VarChar(255)
  version     Int

  @@map("learning_path")
}

/// One course's place in a path. `sequence` is an order, not a gate: no prerequisite rule exists.
model LearningPathStep {
  id         String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id  String    @db.Uuid
  path_id    String    @db.Uuid
  course_id  String    @db.Uuid
  sequence   Int       @db.SmallInt
  optional   Boolean
  metadata   Json
  created_at DateTime  @db.Timestamptz(6)
  created_by String    @db.VarChar(255)
  updated_at DateTime  @db.Timestamptz(6)
  updated_by String    @db.VarChar(255)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.VarChar(255)
  version    Int

  @@map("learning_path_step")
}

/// What an audience must hold, and how often. Configuration that fires nothing (ADR-0071): the
/// audience is resolved through Employment's contract when the rule is reconciled, never stored as
/// a list somebody typed. `recurrence_months` of 0 never repeats.
model LearningMandatoryRule {
  id                   String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id            String    @db.Uuid
  course_id            String    @db.Uuid
  name                 Json
  kind                 String    @db.VarChar(24)
  audience             String    @db.VarChar(24)
  /// Organization's row. No foreign key: a cross-module key does not enforce tenant isolation.
  organization_unit_id String?   @db.Uuid
  position_id          String?   @db.Uuid
  effective_from       DateTime  @db.Date
  recurrence_months    Int       @db.SmallInt
  due_within_days      Int       @db.SmallInt
  active               Boolean
  retired_at           DateTime? @db.Timestamptz(6)
  retired_by           String?   @db.VarChar(255)
  metadata             Json
  created_at           DateTime  @db.Timestamptz(6)
  created_by           String    @db.VarChar(255)
  updated_at           DateTime  @db.Timestamptz(6)
  updated_by           String    @db.VarChar(255)
  deleted_at           DateTime? @db.Timestamptz(6)
  deleted_by           String?   @db.VarChar(255)
  version              Int

  @@index([tenant_id, active, course_id], map: "learning_mandatory_rule_active_idx")
  @@map("learning_mandatory_rule")
}

/// One person asked to learn one thing by one date. There is no `overdue` status — it is derived
/// from `due_on` and today. `occurrence_key` is a derived civil date, and the partial unique index
/// over it is the whole of ADR-0071's idempotency guarantee.
model LearningAssignment {
  id                            String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                     String    @db.Uuid
  /// Employment's row. No foreign key, for the reason ADR-0042 settled.
  employment_id                 String    @db.Uuid
  course_id                     String    @db.Uuid
  source                        String    @db.VarChar(24)
  mandatory_rule_id             String?   @db.Uuid
  path_id                       String?   @db.Uuid
  occurrence_key                DateTime? @db.Date
  status                        String    @db.VarChar(16)
  due_on                        DateTime? @db.Date
  assigned_at                   DateTime  @db.Timestamptz(6)
  assigned_by                   String    @db.VarChar(255)
  satisfied_by_enrolment_id     String?   @db.Uuid
  satisfied_by_certification_id String?   @db.Uuid
  satisfied_at                  DateTime? @db.Timestamptz(6)
  waived_at                     DateTime? @db.Timestamptz(6)
  /// A named human. `system:auto-approval` is refused by a check constraint.
  waived_by                     String?   @db.VarChar(255)
  waiver_reason                 String?   @db.VarChar(1024)
  cancelled_at                  DateTime? @db.Timestamptz(6)
  cancelled_by                  String?   @db.VarChar(255)
  metadata                      Json
  created_at                    DateTime  @db.Timestamptz(6)
  created_by                    String    @db.VarChar(255)
  updated_at                    DateTime  @db.Timestamptz(6)
  updated_by                    String    @db.VarChar(255)
  deleted_at                    DateTime? @db.Timestamptz(6)
  deleted_by                    String?   @db.VarChar(255)
  version                       Int

  @@index([tenant_id, employment_id, status, due_on], map: "learning_assignment_employment_idx")
  @@map("learning_assignment")
}

/// One employment's participation in one version of one course. Completion is immutable — the
/// domain refuses the transition and a trigger refuses it again.
model LearningEnrolment {
  id                String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id         String    @db.Uuid
  employment_id     String    @db.Uuid
  course_id         String    @db.Uuid
  /// Pinned at enrolment. The reason history stays reproducible without a snapshot.
  course_version_id String    @db.Uuid
  assignment_id     String?   @db.Uuid
  status            String    @db.VarChar(16)
  enrolled_at       DateTime  @db.Timestamptz(6)
  enrolled_by       String    @db.VarChar(255)
  started_at        DateTime? @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)
  /// A named human. A completion with nobody's name against it cannot be questioned later.
  completed_by      String?   @db.VarChar(255)
  /// The civil day they finished — what the recurrence arithmetic reads.
  completed_on      DateTime? @db.Date
  outcome_note      String?   @db.VarChar(1024)
  metadata          Json
  created_at        DateTime  @db.Timestamptz(6)
  created_by        String    @db.VarChar(255)
  updated_at        DateTime  @db.Timestamptz(6)
  updated_by        String    @db.VarChar(255)
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_by        String?   @db.VarChar(255)
  version           Int

  @@index([tenant_id, employment_id, status], map: "learning_enrolment_employment_idx")
  @@index([tenant_id, course_id, status], map: "learning_enrolment_course_idx")
  @@map("learning_enrolment")
}

/// One assessor's record of how one enrolment went. Insert-only by trigger; a later result
/// supersedes an earlier one by being later.
model LearningAssessmentResult {
  id             String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id      String    @db.Uuid
  assessment_id  String    @db.Uuid
  enrolment_id   String    @db.Uuid
  employment_id  String    @db.Uuid
  outcome        String    @db.VarChar(16)
  /// The tenant's own text, kept verbatim. Nothing in this product reads, compares or totals it.
  raw_mark       String?   @db.VarChar(32)
  raw_mark_scale String?   @db.VarChar(255)
  assessed_on    DateTime  @db.Date
  assessed_by    String    @db.VarChar(255)
  notes          String?   @db.VarChar(4000)
  recorded_at    DateTime  @db.Timestamptz(6)
  metadata       Json
  created_at     DateTime  @db.Timestamptz(6)
  created_by     String    @db.VarChar(255)
  updated_at     DateTime  @db.Timestamptz(6)
  updated_by     String    @db.VarChar(255)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_by     String?   @db.VarChar(255)
  version        Int

  @@index([tenant_id, enrolment_id, assessed_on(sort: Desc)], map: "learning_assessment_result_enrolment_idx")
  @@map("learning_assessment_result")
}

/// What somebody holds, and until when (ADR-0070). There is no `expired` status: `valid_until` is
/// the only fact and expiry is derived on read. `source` permits a certification with no enrolment
/// behind it, so recording a licence somebody already held does not fabricate a course they took.
model LearningCertification {
  id                          String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id                   String    @db.Uuid
  employment_id               String    @db.Uuid
  enrolment_id                String?   @db.Uuid
  course_id                   String?   @db.Uuid
  title                       String    @db.VarChar(255)
  source                      String    @db.VarChar(24)
  status                      String    @db.VarChar(16)
  issued_on                   DateTime  @db.Date
  valid_until                 DateTime? @db.Date
  supersedes_certification_id String?   @db.Uuid
  /// Documents' row identifier and nothing else. No bytes, no copied metadata (ADR-0070).
  evidence_document_id        String?   @db.Uuid
  revoked_at                  DateTime? @db.Timestamptz(6)
  revoked_by                  String?   @db.VarChar(255)
  revocation_reason           String?   @db.VarChar(1024)
  issued_by                   String    @db.VarChar(255)
  metadata                    Json
  created_at                  DateTime  @db.Timestamptz(6)
  created_by                  String    @db.VarChar(255)
  updated_at                  DateTime  @db.Timestamptz(6)
  updated_by                  String    @db.VarChar(255)
  deleted_at                  DateTime? @db.Timestamptz(6)
  deleted_by                  String?   @db.VarChar(255)
  version                     Int

  @@index([tenant_id, employment_id, status], map: "learning_certification_employment_idx")
  @@map("learning_certification")
}

/// Who teaches, as an identity and only as an identity (D-6). An internal instructor is an
/// employment reference with no copied personal data; an external one is a Learning-owned record,
/// because a visiting trainer is not an employee and gets no fabricated Person row. Nothing here
/// schedules anybody — no availability, no calendar, no booking.
model LearningInstructor {
  id                    String    @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  tenant_id             String    @db.Uuid
  employment_id         String?   @db.Uuid
  external_name         Json?
  external_organization String?   @db.VarChar(255)
  external_contact      String?   @db.VarChar(255)
  active                Boolean
  metadata              Json
  created_at            DateTime  @db.Timestamptz(6)
  created_by            String    @db.VarChar(255)
  updated_at            DateTime  @db.Timestamptz(6)
  updated_by            String    @db.VarChar(255)
  deleted_at            DateTime? @db.Timestamptz(6)
  deleted_by            String?   @db.VarChar(255)
